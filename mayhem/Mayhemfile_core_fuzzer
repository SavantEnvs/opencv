project: savantenvs/opencv
target: core_fuzzer

# cv::imdecode(any codec) -> Mat::clone -> t()/inv()/diag() -> cv::split/merge; input = an image followed by 4 trailing FuzzedDataProvider bytes.
# In-process libFuzzer harness (mayhem/harnesses/core_fuzzer.cc); the library (core, imgproc, imgcodecs +
# vendored codecs) is built with ASan+UBSan (halting) and SanCov by mayhem/build.sh.
# Seeds: the server-accumulated corpus plus the per-target starter seeds committed under
# mayhem/core_fuzzer/testsuite (resolved on the CI runner checkout).
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/core_fuzzer/testsuite

cmds:
  - cmd: /mayhem/core_fuzzer
    libfuzzer: true
