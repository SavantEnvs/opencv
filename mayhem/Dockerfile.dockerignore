# BuildKit per-Dockerfile ignore file for `docker build -f mayhem/Dockerfile .` (upstream ships no
# root .dockerignore). Goal: bake in the FULL repo (including .git history — the grader uses it),
# dropping only local build outputs a developer tree may carry. Never exclude .git.
# build.sh recreates everything below inside the image.
build/
ctrf-report.json
/opencv_kat
/core_fuzzer
/core_fuzzer-standalone
/imdecode_fuzzer
/imdecode_fuzzer-standalone
/imencode_fuzzer
/imencode_fuzzer-standalone
/imread_fuzzer
/imread_fuzzer-standalone
/filestorage_read_file_fuzzer
/filestorage_read_file_fuzzer-standalone
/filestorage_read_string_fuzzer
/filestorage_read_string_fuzzer-standalone
/filestorage_read_filename_fuzzer
/filestorage_read_filename_fuzzer-standalone
/generateusergallerycollage_fuzzer
/generateusergallerycollage_fuzzer-standalone
# editor / OS noise
.DS_Store
*.swp
*~
